{
  "manifest_version": 3,
  "name": "ConceptLens Everywhere",
  "version": "1.0.0",
  "description": "Accessible reading controls, focus ruler, and on-demand AI learning assistance on third-party websites.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ConceptLens Everywhere",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-toolbar": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Toggle ConceptLens accessible toolbar on the current page"
    },
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle reading ruler on the current page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "content/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

