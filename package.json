{
  "name": "conceptlens-monorepo",
  "version": "2.0.0",
  "description": "ConceptLens 2.0 - Accessible AI-assisted learning platform for Computer Science",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "benchmark": "npm run benchmark --workspace=server",
    "fixtures:generate": "npm run fixtures:generate --workspace=server",
    "test:py": "python -m pytest python/test_invariants.py",
    "benchmark:py": "python python/benchmark_evaluator.py",
    "dev:py": "python -m uvicorn python.app:app --reload --port 8000",
    "install:all": "npm install"
  },
  "keywords": [
    "conceptlens",
    "data-structures",
    "linked-list",
    "cloudinary",
    "mern",
    "t3",
    "accessibility",
    "isl",
    "pyq"
  ],
  "author": "ConceptLens Team",
  "license": "MIT"
}
