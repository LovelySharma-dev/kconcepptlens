# Server Configuration
PORT=5000
NODE_ENV=development

# AI Vision Provider (Google Gemini Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
# If omitted, diagram interpretation returns an explicit unavailable status; no fixture is presented as AI output.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# Cloudinary Credentials (Signed Upload Pipeline & Responsive Deskew/Crop)
# Free tier from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_PRESET=conceptlens_uploads

# Database Configuration (MongoDB)
# If MongoDB is not running locally, server uses in-memory session and attempt caching
MONGODB_URI=mongodb://localhost:27017/conceptlens

# Client Configuration (React 19 + Vite)
VITE_API_URL=http://localhost:5000/api
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
