# Server Configuration
PORT=5000
NODE_ENV=development

# Cloudinary Credentials (Signed Upload Pipeline)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_PRESET=conceptlens_uploads

# Database Configuration (MongoDB)
# If MongoDB is not running locally, server uses resilient in-memory session caching
MONGODB_URI=mongodb://localhost:27017/conceptlens

# Client Configuration
VITE_API_URL=http://localhost:5000/api
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
