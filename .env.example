# Server Configuration
PORT=5000
NODE_ENV=development

# Hugging Face AI Service (Adaptive Learning Engine & Lesson Generation)
# Create a free user access token at: https://huggingface.co/settings/tokens (Read permission is sufficient)
# If omitted or unavailable, the server automatically uses the deterministic rule-based learning engine.
# Do NOT put this token in any client or VITE_ variable.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TIMEOUT_MS=30000
# Optional base URL for Hugging Face Inference API / router
HF_BASE_URL=https://api-inference.huggingface.co/models

# Primary Generative AI Provider (Google Gemini 3.1 Flash-Lite - Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey (Zero cost, no credit card required)
# Verified available free model: gemini-3.1-flash-lite (15 RPM free quota)
# If omitted or rate-limited, the server uses Hugging Face (if configured) or the deterministic rule-based engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini
AI_TIMEOUT_MS=15000

# Cloudinary Credentials (Signed Upload Pipeline & Responsive Deskew/Crop)
# Free tier from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_PRESET=conceptlens_uploads

# Database Configuration (MongoDB)
# If MongoDB is not running locally, server uses in-memory session and attempt caching
MONGODB_URI=mongodb://localhost:27017/conceptlens

# Browser origin allowed to call the API. Comma-separate extra deployed origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Client Configuration (React 18 + Vite)
# The Vite dev server proxies /api to the Express server, so the browser does not need a Cloudinary secret.
# Do not put CLOUDINARY_API_SECRET or any model API key in a VITE_ variable.
VITE_API_URL=http://localhost:5000/api

# Optional public Cloudinary cloud name for client delivery.
# Leave this unset, or set a real cloud name. The placeholder below is ignored.
# Do not put the API secret in this variable. Educational diagrams fall back to
# Cloudinary's public demo cloud when this is empty or still a placeholder.
# VITE_CLOUDINARY_CLOUD_NAME=

# Optional local path for the Python answer-weight file.
# Leave this unset to use python/data/learner_state.json.
# This is not an API key. No additional key is required for text, PDF text layers,
# sample lessons, or the local evidence engine.
# GEMINI_API_KEY is not used by the learning-material pipeline.
# Do not put secrets in VITE_ variables.
# CONCEPTLENS_LEARNER_STATE=
