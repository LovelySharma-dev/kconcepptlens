# ==============================================================================
# ConceptLens 2.0 — .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs & Bundles
dist/
build/
out/
.vite/
*.tsbuildinfo

# Environment & Secrets (Never commit secrets or API keys)
.env
.env.*
!.env.example
*.pem

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.coverage.*
.mypy_cache/
.ruff_cache/

# Testing & Code Quality
coverage/
.nyc_output/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor, IDE & Workspace Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Caches & Temporary Storage
.cache/
.parcel-cache/
.turbo/
tmp/
temp/
fixtures/synthetic/
python/data/*.json
server/ocr-cache/
